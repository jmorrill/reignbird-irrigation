# Copy to .env and edit. docker compose reads it automatically.
#   cp .env.example .env

# ---------------------------------------------------------------- required

# Watering plans run in local time. Without this, a plan set for 6am waters at 6am
# UTC — it does not error, it just waters at the wrong hour. Any IANA zone name.
TZ=America/Los_Angeles


# ------------------------------------------------------------------- data

# Where the database, encryption keys and zone photos live on the host. This
# directory is the whole backup; everything else can be rebuilt from the repo.
# Relative paths are resolved from this file's directory.
REIGNBIRD_DATA=./data

# Who the container runs as. It has to be able to write REIGNBIRD_DATA.
#
# On Linux, a directory you created belongs to you, not to the image's built-in user,
# so set these to your own ids and nothing needs chowning:
#     id -u    ->  PUID
#     id -g    ->  PGID
# On Docker Desktop for Windows or macOS the defaults are fine — bind mounts there do
# not carry host ownership through.
PUID=1654
PGID=1654


# --------------------------------------------------------------- optional

# Host port, if 5056 is taken.
#REIGNBIRD_PORT=5056

# Creates this account at startup when it does not already exist, so an unattended
# container does not sit waiting for somebody to open the setup screen. Leave both
# unset to use the first-run setup screen instead.
#
# An account that already exists is never modified, so leaving these here cannot
# silently undo a password you changed later. Locked out? Set these to a *new*
# username — every account is equal, so the new one can remove the old.
#REIGNBIRD_ADMIN_USER=admin
#REIGNBIRD_ADMIN_PASSWORD=change-this-please
