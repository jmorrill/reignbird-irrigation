# .NET
bin/
obj/
*.user
*.db
*.db-shm
*.db-wal

# Server runtime state (SQLite database, Data Protection keys, uploaded photos)
src/RainBird.Server/store/
src/RainBird.Server/media/

# The same state when running in Docker, where it is bind-mounted from the host.
# REIGNBIRD_DATA can point anywhere; this covers the default.
/data/

# Local environment. Holds TZ, the host uid/gid, and possibly an admin password —
# none of which belongs in the repository. .env.example is the committed version.
.env
.env.*
!.env.example

# Node
node_modules/
dist/
.vite/

# Playwright
.playwright-mcp/
test-results/
playwright-report/

# OS
Thumbs.db
.DS_Store

# Built SPA output (produced by `npm run build` in web/)
src/RainBird.Server/wwwroot/

# Screenshots captured during verification. Anchored to the repo root on purpose:
# a bare *.png would also swallow the generated app icons in web/public, which are
# committed so that an ordinary build never has to regenerate them.
/*.png
.playwright-mcp/
